package collection;

import java.util.ArrayList;

public class C002_Arralist {
	public static void main(String[] args) {
		
		
		
		ArrayList<Integer> al = new ArrayList<Integer>();
		al.add(10);
		al.add(20);
		al.add(30);
		al.add(40);
		al.add(50);
		
		
		ArrayList<Integer> al1 = new ArrayList<Integer>(al);
		al1.add(1);
		al1.add(2);
		al1.add(6);
		al1.add(4);
		al1.add(5);
		al1.addAll(al);
		al1.removeAll(al);
		
		for(Integer i : al1)
		{
			System.out.println(i);
		}
		
		
		
		
		
		
	}
}

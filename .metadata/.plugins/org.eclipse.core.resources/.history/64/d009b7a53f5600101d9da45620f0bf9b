package collection;

import java.util.Comparator;

public class SortProductByPrice implements Comparator<Product> {

	@Override
	public int compare(Product o1, Product o2) {
		
		int a = o1.id;
		int b = o2.id;
		int i=0;
		
		if(a>b)
		{
			i = 1;
		}
		else if(a<b)
		{
			i=-1;
		}
		
		
		return i;
	}

}

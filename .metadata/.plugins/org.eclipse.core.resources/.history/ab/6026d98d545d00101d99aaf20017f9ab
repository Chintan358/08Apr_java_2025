package thread;

class T1 extends Thread
{
	public void run()
	{
		for(int i=1;i<=10;i++)
		{
			System.out.println(currentThread().getName()+" : "+i);
		}
	}
}


public class T001_ThreadDemo {
	public static void main(String[] args) {
		
		T1 t1 = new T1();
		T1 t2 = new T1();
		
		
		t1.start();
		t2.start();
		
	}
}

package collection;

public class Product {
	
	
			int id;
			String name;
			double price;
			int qty;
			public Product(int id, String name, double price, int qty) {
				super();
				this.id = id;
				this.name = name;
				this.price = price;
				this.qty = qty;
			}
			
			@Override
			public String toString() {
				return "Product [id=" + id + ", name=" + name + ", price=" + price + ", qty=" + qty + "]";
			}
			
			
			
}
